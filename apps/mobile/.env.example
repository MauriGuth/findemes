# Base URL of the API the app talks to while Metro serves the JS (development builds).
# `pnpm dev:railway` ignores this file and uses the Railway API.
# Local API: Android emulator reaches the host at 10.0.2.2; a physical phone on the same
# Wi-Fi uses your computer's LAN IP, e.g. http://192.168.0.10:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
