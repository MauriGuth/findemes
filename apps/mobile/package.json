{
  "name": "@findemes/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Findemes mobile app (Expo SDK 57, expo-router, dev client).",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "export:android": "expo export --platform android --output-dir dist",
    "eas-build-post-install": "pnpm --filter @findemes/shared build",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@findemes/shared": "workspace:*",
    "@tanstack/react-query": "5.103.2",
    "expo": "~57.0.24",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@findemes/config": "workspace:*",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.12",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "expo-doctor": "1.20.4",
    "tailwindcss": "3.4.19",
    "typescript": "~6.0.3"
  }
}
