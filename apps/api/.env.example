# Copy to .env for local development. Never commit .env.

# Postgres from `docker compose up -d` (see docker-compose.yml at the repo root).
DATABASE_URL="postgresql://findemes:findemes@localhost:5432/findemes"

# development | test | production
NODE_ENV=development
PORT=3000

# Comma-separated browser origins allowed to call the API. Empty = CORS disabled
# (the mobile app does not need it).
CORS_ORIGINS=

# Serve OpenAPI docs at /docs. Defaults to true outside production.
SWAGGER_ENABLED=true

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate real secrets with:  openssl rand -base64 48
# Placeholders starting with "dev-only-" are refused in production.
JWT_SECRET=dev-only-change-me-jwt-secret-000000000000000000
OTP_PEPPER=dev-only-change-me-otp-pepper-000000000000000000
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
REFRESH_FAMILY_MAX_DAYS=180
OTP_TTL_MINUTES=10
# Total login codes per day before the API stops sending (Resend free tier: 100/day).
OTP_GLOBAL_DAILY_CAP=100

# ── Mail ───────────────────────────────────────────────────────────────────────
# console (default in development: the code is printed in the API console)
# fake    (default in test)
# resend  (required in production; needs RESEND_API_KEY and MAIL_FROM)
MAIL_PROVIDER=console
RESEND_API_KEY=
# Without a verified domain, Resend only delivers onboarding@resend.dev to your own account email.
MAIL_FROM=Findemes <onboarding@resend.dev>

# ── Automatic capture (Phase 2) ────────────────────────────────────────────────
# AES-256-GCM key for stored notifications: openssl rand -base64 32
# Without it the API boots but automatic capture answers 503 and stores nothing.
# This dev-only key is refused in production.
RAW_EVENT_KEY=ZGV2LW9ubHktcmF3LWV2ZW50LWtleS0wMDAwMDAwMDA=
RAW_EVENT_KEY_VERSION=1
INGEST_TOKEN_ROTATE_DAYS=30

# ── Claude fallback for notifications no template recognizes ──────────────────
# anthropic | fake | none. Default: anthropic when ANTHROPIC_API_KEY is set, otherwise none.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# Claude calls per user per day.
LLM_DAILY_CAP=30
LLM_TIMEOUT_MS=15000

# ── Forwarded email (Phase 3, ADR 013) ────────────────────────────────────────
# Postmark inbound address of the server ("abc123@inbound.postmarkapp.com"). Each user gets
# abc123+<token>@... Empty: the email feature says it is not available yet.
INBOUND_EMAIL_ADDRESS=
# Basic auth Postmark sends with the webhook: https://USER:PASSWORD@<api>/inbound/postmark
INBOUND_WEBHOOK_USER=
INBOUND_WEBHOOK_PASSWORD=
# Claude calls for emails per user per day, and their timeout (PDFs are slow).
EMAIL_LLM_DAILY_CAP=40
EMAIL_LLM_TIMEOUT_MS=90000

# ── Ticket photos and AI entries (Phase 4, ADR 014) ───────────────────────────
# S3-compatible bucket, private (Cloudflare R2: endpoint https://<account>.r2.cloudflarestorage.com,
# region auto). All four or none. Empty: tickets say they are not available yet.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Claude calls per user per day for tickets and typed/chat entries, and the photo timeout.
ASSIST_LLM_DAILY_CAP=40
RECEIPT_LLM_TIMEOUT_MS=60000

# ── Chats (Phase 4, ADR 014) ──────────────────────────────────────────────────
# Public https URL of this API; the Telegram webhook is registered there on boot.
API_PUBLIC_URL=
# Telegram bot from @BotFather. All three or none. Secret: openssl rand -hex 32
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp Business Cloud API (Meta). All five or none.
# Webhook: https://<api>/chat/whatsapp (verify token below), field "messages".
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# The number users write to, digits with country code: 5492991234567
WHATSAPP_DISPLAY_NUMBER=
