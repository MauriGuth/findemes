// Findemes — Prisma schema (PostgreSQL)
//
// Conventions
// - ids are UUID v7 (time-ordered, generated by the app)
// - money is Decimal(18, 2) + a Currency; never floats
// - every timestamp is timestamptz
// - deleting a User cascades: account deletion is real (stores require it)
// - enums are mirrored in packages/shared/src/schemas/enums.ts (a test enforces it)

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Currency {
  ARS
  USD
}

enum TransactionDirection {
  IN
  OUT
}

/// Debit, transfer, wallet and cash leave the account today; credit goes to next month's statement.
enum PaymentMethod {
  DEBIT
  CREDIT
  TRANSFER
  CASH
  WALLET
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  IGNORED
}

enum TransactionOrigin {
  TEMPLATE
  LLM
  MANUAL
}

enum RawEventChannel {
  ANDROID_NOTIFICATION
  IOS_SHORTCUT
  EMAIL
  RECEIPT_PHOTO
  MANUAL
}

enum RawEventStatus {
  RECEIVED
  PROCESSED
  UNRECOGNIZED
  FAILED
}

enum SourceKind {
  BANK
  WALLET
  CARD
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum CommitmentKind {
  RENT
  SERVICE
  INSTALLMENT
  SUBSCRIPTION
  DEBIT
}

enum ReceiptStatus {
  UPLOADED
  EXTRACTED
  MATCHED
  UNMATCHED
  FAILED
}

// ─── Identity ────────────────────────────────────────────────────────────────

model User {
  id                String   @id @default(uuid(7))
  email             String   @unique
  name              String?
  timeZone          String   @default("America/Argentina/Buenos_Aires")
  /// HH:MM in Argentina time; null = daily reminder off.
  dailyReminderTime String?  @default("20:00")
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @updatedAt @db.Timestamptz

  devices       Device[]
  refreshTokens RefreshToken[]
  rawEvents     RawEvent[]
  transactions  Transaction[]
  receipts      Receipt[]
  categories    Category[]
  monthPlans    MonthPlan[]
  commitments   Commitment[]
}

model Device {
  id              String         @id @default(uuid(7))
  userId          String
  platform        DevicePlatform
  name            String?
  appVersion      String?
  pushToken       String?
  /// Android only: whether the notification listener is granted and running.
  listenerEnabled Boolean        @default(false)
  lastSeenAt      DateTime?      @db.Timestamptz
  createdAt       DateTime       @default(now()) @db.Timestamptz
  updatedAt       DateTime       @updatedAt @db.Timestamptz

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawEvents     RawEvent[]
  refreshTokens RefreshToken[]

  @@index([userId])
}

// ─── Auth ────────────────────────────────────────────────────────────────────

/// One-time login code sent by email. No FK to User: the user may not exist yet.
model LoginCode {
  id         String    @id @default(uuid(7))
  email      String
  /// hex HMAC-SHA256(OTP_PEPPER, `${email}\n${code}`)
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime  @db.Timestamptz
  consumedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  @@index([email, createdAt(sort: Desc)])
  @@index([expiresAt])
}

/// Opaque rotating refresh token. Reusing a revoked token revokes its whole family.
model RefreshToken {
  id              String    @id @default(uuid(7))
  userId          String
  deviceId        String?
  /// hex sha256 of the opaque token
  tokenHash       String    @unique
  familyId        String
  /// Copied on every rotation: the family dies REFRESH_FAMILY_MAX_DAYS after the login.
  familyCreatedAt DateTime  @db.Timestamptz
  expiresAt       DateTime  @db.Timestamptz
  revokedAt       DateTime? @db.Timestamptz
  replacedById    String?
  createdAt       DateTime  @default(now()) @db.Timestamptz

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// ─── Catalog (system tables, no userId) ──────────────────────────────────────

/// A bank, wallet or card issuer we know how to read. Seeded, not user-created.
model Source {
  id          String     @id @default(uuid(7))
  slug        String     @unique
  name        String
  kind        SourceKind
  /// Android package name of the app whose notifications we capture.
  packageName String?    @unique
  /// Hints for iOS channels (mail senders, shortcut templates).
  iosHints    Json?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.Timestamptz
  updatedAt   DateTime   @updatedAt @db.Timestamptz

  transactions    Transaction[]
  commitments     Commitment[]
  parserTemplates ParserTemplate[]
}

/// Deterministic parsing rule for one source. Versioned in the database so it
/// can be updated without shipping a release.
model ParserTemplate {
  id        String   @id @default(uuid(7))
  sourceId  String
  name      String
  version   Int      @default(1)
  /// Regular expression with named groups.
  pattern   String
  /// Maps named groups to Transaction fields and applies normalizations.
  fieldMap  Json
  /// Lower runs first.
  priority  Int      @default(100)
  active    Boolean  @default(true)
  /// Anonymized samples the template was built from.
  samples   Json?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, name, version])
  @@index([sourceId, active, priority])
}

/// System categories have userId = null; users can add their own.
model Category {
  id        String   @id @default(uuid(7))
  userId    String?
  slug      String
  name      String
  icon      String?
  parentId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]    @relation("CategoryTree")
  transactions Transaction[]
  receiptItems ReceiptItem[]
  commitments  Commitment[]

  @@unique([userId, slug])
  @@index([parentId])
}

// ─── Ingestion ───────────────────────────────────────────────────────────────

/// Anything that came in before parsing: a notification, a forwarded mail, a
/// shortcut POST, a receipt photo. The payload is encrypted at rest and the row
/// is purged 30 days after it arrives.
model RawEvent {
  id          String          @id @default(uuid(7))
  userId      String
  deviceId    String?
  channel     RawEventChannel
  packageName String?
  /// Notification key / message id from the origin, for idempotency.
  externalKey String?
  /// When the origin posted it (notification timestamp, mail date).
  postedAt    DateTime        @db.Timestamptz
  payloadEnc  Bytes
  payloadIv   Bytes
  keyVersion  Int             @default(1)
  status      RawEventStatus  @default(RECEIVED)
  error       String?
  receivedAt  DateTime        @default(now()) @db.Timestamptz
  processedAt DateTime?       @db.Timestamptz
  /// receivedAt + 30 days; the purge job deletes rows past this instant.
  expiresAt   DateTime        @db.Timestamptz

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  device      Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  transaction Transaction?

  @@unique([deviceId, externalKey, postedAt])
  @@index([userId, status])
  @@index([expiresAt])
}

// ─── Money ───────────────────────────────────────────────────────────────────

model Transaction {
  id                 String               @id @default(uuid(7))
  userId             String
  sourceId           String?
  amount             Decimal              @db.Decimal(18, 2)
  currency           Currency             @default(ARS)
  direction          TransactionDirection
  method             PaymentMethod
  merchantRaw        String?
  merchantNorm       String?
  categoryId         String?
  occurredAt         DateTime             @db.Timestamptz
  capturedAt         DateTime             @default(now()) @db.Timestamptz
  status             TransactionStatus    @default(PENDING)
  /// 0.00–1.00; >= 0.90 confirms automatically, 0.60–0.89 asks the user.
  confidence         Decimal              @default(1) @db.Decimal(3, 2)
  origin             TransactionOrigin
  /// hash(userId, sourceId, amount, occurredAt rounded to 2 min, merchantNorm) for dedup.
  fingerprint        String
  rawEventId         String?              @unique
  receiptId          String?              @unique
  note               String?
  /// Transfer between the user's own accounts: never income nor expense.
  isOwnTransfer      Boolean              @default(false)
  /// Set when this movement pays a Commitment.
  commitmentId       String?
  /// First day of the month the payment settles (may differ from occurredAt's month). Required with commitmentId.
  commitmentMonth    DateTime?            @db.Date
  /// Cash payment of the previous month's credit card statement.
  isStatementPayment Boolean              @default(false)
  createdAt          DateTime             @default(now()) @db.Timestamptz
  updatedAt          DateTime             @updatedAt @db.Timestamptz

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  source       Source?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  category     Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  rawEvent     RawEvent?   @relation(fields: [rawEventId], references: [id], onDelete: SetNull)
  receipt      Receipt?    @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  commitment   Commitment? @relation(fields: [commitmentId], references: [id], onDelete: SetNull)
  salaryOfPlan MonthPlan?  @relation("MonthPlanSalary")

  @@unique([userId, fingerprint])
  @@index([userId, occurredAt(sort: Desc)])
  @@index([userId, status])
  @@index([commitmentId, commitmentMonth])
}

model Receipt {
  id                String         @id @default(uuid(7))
  userId            String
  /// Object key in the S3-compatible bucket. Never a local path.
  imageKey          String
  merchant          String?
  cuit              String?
  issuedAt          DateTime?      @db.Timestamptz
  total             Decimal?       @db.Decimal(18, 2)
  currency          Currency       @default(ARS)
  paymentMethodHint PaymentMethod?
  /// Raw LLM extraction, encrypted at rest, kept to reprocess when the prompt improves.
  extractionEnc     Bytes?
  extractionIv      Bytes?
  keyVersion        Int            @default(1)
  status            ReceiptStatus  @default(UPLOADED)
  error             String?
  createdAt         DateTime       @default(now()) @db.Timestamptz
  updatedAt         DateTime       @updatedAt @db.Timestamptz

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ReceiptItem[]
  transaction Transaction?

  @@index([userId, createdAt(sort: Desc)])
}

model ReceiptItem {
  id         String   @id @default(uuid(7))
  receiptId  String
  position   Int
  name       String
  qty        Decimal  @default(1) @db.Decimal(12, 3)
  unitPrice  Decimal? @db.Decimal(18, 2)
  total      Decimal  @db.Decimal(18, 2)
  categoryId String?

  receipt  Receipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([receiptId])
}

// ─── Planning ("Hasta el 1") ─────────────────────────────────────────────────

model MonthPlan {
  id                  String   @id @default(uuid(7))
  userId              String
  /// First day of the month, as a date.
  month               DateTime @db.Date
  expectedIncome      Decimal  @db.Decimal(18, 2)
  currency            Currency @default(ARS)
  /// The credit the user confirmed as this month's salary (may have occurredAt outside the month).
  salaryTransactionId String?  @unique
  createdAt           DateTime @default(now()) @db.Timestamptz
  updatedAt           DateTime @updatedAt @db.Timestamptz

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  salaryTransaction Transaction? @relation("MonthPlanSalary", fields: [salaryTransactionId], references: [id], onDelete: SetNull)

  @@unique([userId, month])
}

/// Rent, services, installments, subscriptions, automatic debits: what leaves
/// the account every month whether you notice or not.
model Commitment {
  id                String         @id @default(uuid(7))
  userId            String
  kind              CommitmentKind
  name              String
  amount            Decimal        @db.Decimal(18, 2)
  currency          Currency       @default(ARS)
  /// CREDIT goes to next statement; anything else leaves cash this month.
  method            PaymentMethod  @default(DEBIT)
  /// 1-31; clamped to the last day of shorter months.
  dayOfMonth        Int
  installmentsTotal Int?
  /// First day of the first month this applies to (API normalizes to day 1).
  startsOn          DateTime       @db.Date
  /// First day of the last month this applies to; null = open-ended. INSTALLMENT: recomputed on every write as startsOn + (installmentsTotal - 1) months.
  endsOn            DateTime?      @db.Date
  sourceId          String?
  categoryId        String?
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now()) @db.Timestamptz
  updatedAt         DateTime       @updatedAt @db.Timestamptz

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  source   Source?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  category Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payments Transaction[]

  @@index([userId, active])
}
