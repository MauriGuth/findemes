{
  "name": "@findemes/api",
  "version": "0.0.0",
  "private": true,
  "description": "Findemes backend: NestJS 12 + Prisma 7 + PostgreSQL.",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@findemes/shared": "workspace:*",
    "@nestjs/common": "12.0.4",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.2",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@findemes/config": "workspace:*",
    "@nestjs/cli": "12.0.3",
    "@nestjs/schematics": "12.0.4",
    "@nestjs/testing": "12.0.4",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "prettier": "3.9.8",
    "supertest": "7.2.2",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
