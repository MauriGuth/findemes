{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "CI"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "PORT",
    "CORS_ORIGINS",
    "SWAGGER_ENABLED",
    "EXPO_PUBLIC_*",
    "EXPO_*",
    "EAS_*",
    "JWT_SECRET",
    "JWT_ACCESS_TTL_SECONDS",
    "REFRESH_TTL_DAYS",
    "REFRESH_FAMILY_MAX_DAYS",
    "OTP_PEPPER",
    "OTP_TTL_MINUTES",
    "OTP_GLOBAL_DAILY_CAP",
    "MAIL_PROVIDER",
    "RESEND_API_KEY",
    "MAIL_FROM",
    "E2E_ALLOW_REMOTE_DB"
  ],
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test:e2e": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false
    }
  }
}
